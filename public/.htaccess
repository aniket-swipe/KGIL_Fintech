# KGIL Fintech Solutions Private Limited — Apache / cPanel configuration.
# Delete this file if the site is served by nginx, Netlify, Vercel or
# Cloudflare Pages; see README.md for the equivalent settings.

# ------------------------------------------------- custom 404, real status --
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One preferred domain: https, no www.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://kgilfintech.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.kgilfintech\.com$ [NC]
  RewriteRule ^(.*)$ https://kgilfintech.com/$1 [R=301,L]

  # Directory URLs keep their trailing slash, so /privacy-policy sends one
  # redirect to /privacy-policy/ rather than serving both.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(/$|\.[a-zA-Z0-9]{2,5}$)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------- caching --
<IfModule mod_headers.c>
  # Hashed build assets never change under the same name.
  <FilesMatch "\.(js|css|woff2|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always be revalidated so deploys go live immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Crawlable, but not indexable as documents in their own right.
  <FilesMatch "\.(txt|xml)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

AddType text/plain .txt
AddDefaultCharset UTF-8
